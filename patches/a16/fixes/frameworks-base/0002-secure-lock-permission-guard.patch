From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Avium A16 Reproducer <avium-a16-reproducer@example.invalid>
Date: Mon, 10 Aug 2026 00:00:01 +0000
Subject: [PATCH] SystemUI: tolerate absent secure-lock permission

---
diff --git a/packages/SystemUI/src/com/android/systemui/securelockdevice/data/repository/SecureLockDeviceRepository.kt b/packages/SystemUI/src/com/android/systemui/securelockdevice/data/repository/SecureLockDeviceRepository.kt
index 7034306447b9..cc19ca41a480 100644
--- a/packages/SystemUI/src/com/android/systemui/securelockdevice/data/repository/SecureLockDeviceRepository.kt
+++ b/packages/SystemUI/src/com/android/systemui/securelockdevice/data/repository/SecureLockDeviceRepository.kt
@@ -81,12 +81,22 @@ constructor(
                     }
 
                 updateSecureLockDeviceEnabledState(false)
-                authenticationPolicyManager?.registerSecureLockDeviceStatusListener(
-                    backgroundExecutor,
-                    listener,
-                )
+                try {
+                    authenticationPolicyManager?.registerSecureLockDeviceStatusListener(
+                        backgroundExecutor,
+                        listener,
+                    )
+                } catch (_: SecurityException) {
+                    // MANAGE_SECURE_LOCK_DEVICE is not declared in framework-res in this
+                    // build (aconfig flag mismatch): the registration always throws
+                    // SecurityException and crash-loops SystemUI. Skip it.
+                }
                 awaitClose {
-                    authenticationPolicyManager?.unregisterSecureLockDeviceStatusListener(listener)
+                    try {
+                        authenticationPolicyManager?.unregisterSecureLockDeviceStatusListener(
+                            listener)
+                    } catch (_: SecurityException) {
+                    }
                 }
             }
         } else {
