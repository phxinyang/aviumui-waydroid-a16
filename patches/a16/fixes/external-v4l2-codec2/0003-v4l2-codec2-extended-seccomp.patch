diff --git a/service/android.hardware.media.c2-extended-seccomp_policy b/service/android.hardware.media.c2-extended-seccomp_policy
new file mode 100644
index 0000000..734c53c
--- /dev/null
+++ b/service/android.hardware.media.c2-extended-seccomp_policy
@@ -0,0 +1,14 @@
+# Extra syscalls for the v4l2 codec2 HAL (Waydroid/AviumUI coexistence build).
+#
+# The base c2-default policy is too strict for the encoder/decoder path:
+# - uname: mesa/libdrm and libavutil probe the kernel/CPU (observed SIGSYS
+#   on __NR_uname while starting c2.v4l2.avc.encoder)
+# - kcmp/sched_getaffinity/sysinfo/mkdirat: required by mesa3d (same set as
+#   mediacodec.policy)
+# - sched_setaffinity: codec worker threads pin CPUs
+uname: 1
+kcmp: 1
+sched_getaffinity: 1
+sched_setaffinity: 1
+sysinfo: 1
+mkdirat: 1

