From 8ffc89459868cce339ea7eab0876e628e57bdc7d Mon Sep 17 00:00:00 2001
From: root <root@avium-build.arch>
Date: Sat, 15 Aug 2026 22:50:06 +0000
Subject: [PATCH 1/3] codec2: install ffmpeg extended seccomp policy (uname for
 CPU detection)

---
 codec2/Android.mk                                      | 10 ++++++++++
 .../android.hardware.media.c2-ffmpeg-extended.policy   |  5 +++++
 2 files changed, 15 insertions(+)
 create mode 100644 codec2/seccomp_policy/android.hardware.media.c2-ffmpeg-extended.policy

diff --git a/codec2/Android.mk b/codec2/Android.mk
index a9fcc48..b75de02 100644
--- a/codec2/Android.mk
+++ b/codec2/Android.mk
@@ -24,6 +24,7 @@ LOCAL_VINTF_FRAGMENTS := manifest_media_c2_ffmpeg.xml
 LOCAL_INIT_RC := android.hardware.media.c2-ffmpeg-service.rc
 LOCAL_REQUIRED_MODULES := \
 	android.hardware.media.c2-ffmpeg.policy \
+	android.hardware.media.c2-ffmpeg-extended.policy \
 	media_codecs_ffmpeg_c2.xml
 LOCAL_SRC_FILES := \
 	C2FFMPEGAudioDecodeComponent.cpp \
@@ -74,6 +75,15 @@ LOCAL_SRC_FILES_arm := seccomp_policy/android.hardware.media.c2-ffmpeg-arm.polic
 LOCAL_SRC_FILES_arm64 := seccomp_policy/android.hardware.media.c2-ffmpeg-arm64.policy
 include $(BUILD_PREBUILT)
 
+include $(CLEAR_VARS)
+LOCAL_MODULE := android.hardware.media.c2-ffmpeg-extended.policy
+LOCAL_MODULE_TAGS := optional
+LOCAL_MODULE_CLASS := ETC
+LOCAL_PROPRIETARY_MODULE := true
+LOCAL_MODULE_RELATIVE_PATH := seccomp_policy
+LOCAL_SRC_FILES := seccomp_policy/android.hardware.media.c2-ffmpeg-extended.policy
+include $(BUILD_PREBUILT)
+
 include $(CLEAR_VARS)
 LOCAL_MODULE := media_codecs_ffmpeg_c2.xml
 LOCAL_MODULE_TAGS := optional
diff --git a/codec2/seccomp_policy/android.hardware.media.c2-ffmpeg-extended.policy b/codec2/seccomp_policy/android.hardware.media.c2-ffmpeg-extended.policy
new file mode 100644
index 0000000..08f1f27
--- /dev/null
+++ b/codec2/seccomp_policy/android.hardware.media.c2-ffmpeg-extended.policy
@@ -0,0 +1,5 @@
+# Extra syscalls for the ffmpeg codec2 HAL (Waydroid/AviumUI coexistence build).
+#
+# libavutil's CPU detection calls uname() on aarch64 (observed SIGSYS on
+# __NR_uname while starting the HEVC decoder thread).
+uname: 1

