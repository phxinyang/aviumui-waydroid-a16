From b449cc883333e7bc59c819dc6c5c5a2e7413e6a Mon Sep 17 00:00:00 2001
From: SupeChicken666 <me@supechicken666.dev>
Date: Sun, 18 Jan 2026 13:02:21 +0000
Subject: [PATCH] health: drop capabilities incompatible with Waydroid

The health service runs in the Waydroid container, where Android init
deliberately drops privileged capabilities.  The charger service must not
request CAP_SYS_BOOT, otherwise init aborts service setup before zygote.

---
 health/aidl/default/android.hardware.health-service.example.rc | 3 +--
 1 file changed, 1 insertion(+), 2 deletions(-)

diff --git a/health/aidl/default/android.hardware.health-service.example.rc b/health/aidl/default/android.hardware.health-service.example.rc
index e052024..0000000 100644
--- a/health/aidl/default/android.hardware.health-service.example.rc
+++ b/health/aidl/default/android.hardware.health-service.example.rc
@@ -2,7 +2,7 @@ service vendor.health-default /vendor/bin/hw/android.hardware.health-service.example
     class hal
     user system
     group system
-    capabilities WAKE_ALARM BLOCK_SUSPEND
+    capabilities BLOCK_SUSPEND
     file /dev/kmsg w
 
 service vendor.charger /vendor/bin/hw/android.hardware.health-service.example --charger
@@ -21,7 +21,6 @@ service vendor.charger /vendor/bin/hw/android.hardware.health-service.example --charger
     seclabel u:r:charger_vendor:s0
     user system
     group system wakelock input
-    capabilities SYS_BOOT
     file /dev/kmsg w
     file /sys/fs/pstore/console-ramoops-0 r
     file /sys/fs/pstore/console-ramoops r
-- 
2.55.0
