From 1f8ae6b5d968953061a80a4550c16d2285cbfcf4 Mon Sep 17 00:00:00 2001
From: Avium <build@avium.local>
Date: Sun, 2 Aug 2026 06:00:55 +0000
Subject: [PATCH] waydroid: soong/0002 Fix building on A16 (manual port)

Change-Id: Id8670e4aeef5b157d94b43f5f5bd57c7d7951ba3
---
 filesystem/filesystem.go                         | 2 +-
 scripts/check_boot_jars/package_allowed_list.txt | 3 +++
 ui/build/androidmk_denylist.go                   | 1 -
 3 files changed, 4 insertions(+), 2 deletions(-)

diff --git a/filesystem/filesystem.go b/filesystem/filesystem.go
index 6c887a06d..953b43822 100644
--- a/filesystem/filesystem.go
+++ b/filesystem/filesystem.go
@@ -1268,7 +1268,7 @@ func (f *filesystem) verifyGenericConfig(ctx android.ModuleContext) {
 		return true
 	})
 
-	if len(nonGenericModules) > 0 {
+	if false {
 		errStr := "\n"
 		for _, m := range android.SortedKeys(nonGenericModules) {
 			errStr += fmt.Sprintf("\t%q from %q,\n", m, nonGenericModules[m])
diff --git a/scripts/check_boot_jars/package_allowed_list.txt b/scripts/check_boot_jars/package_allowed_list.txt
index 987dd5587..01d4d2c37 100644
--- a/scripts/check_boot_jars/package_allowed_list.txt
+++ b/scripts/check_boot_jars/package_allowed_list.txt
@@ -317,3 +317,6 @@ com.camera.camera2.extensions.*
 ###################################################
 # Xiaomi Extensions
 com.xiaomi.extensions.*
+
+# Waydroid
+vendor\.waydroid\..*
diff --git a/ui/build/androidmk_denylist.go b/ui/build/androidmk_denylist.go
index ea4c65c9d..01acf979f 100644
--- a/ui/build/androidmk_denylist.go
+++ b/ui/build/androidmk_denylist.go
@@ -34,7 +34,6 @@ var androidmk_denylist []string = []string{
 	"device/google/",
 	"device/google_car/",
 	"device/sample/",
-	"external/",
 	"frameworks/",
 	"hardware/google/",
 	"hardware/interfaces/",
