+package com.android.wm.shell.desktopmode
+
+import android.app.ActivityManager.RunningTaskInfo
+import android.app.WindowConfiguration.WINDOWING_MODE_FREEFORM
+import android.graphics.Rect
+import android.os.IHwBinder
+import android.os.RemoteException
+import android.util.Slog
+import android.window.WindowContainerTransaction
+import com.android.wm.shell.ShellTaskOrganizer
+import com.android.wm.shell.common.DisplayController
+import com.android.wm.shell.common.ShellExecutor
+import com.android.wm.shell.desktopmode.DesktopModeEventLogger.Companion.InputMethod
+import com.android.wm.shell.desktopmode.DesktopModeEventLogger.Companion.MinimizeReason
+import com.android.wm.shell.desktopmode.DesktopModeEventLogger.Companion.UnminimizeReason
+import com.android.wm.shell.desktopmode.common.ToggleTaskSizeInteraction
+import java.util.NoSuchElementException
+import java.util.concurrent.atomic.AtomicLong
+import vendor.waydroid.window.V1_3.IWaydroidWindow
+import vendor.waydroid.window.V1_3.IWaydroidWindowCallback
+import vendor.waydroid.window.V1_3.TaskWindowBounds
+import vendor.waydroid.window.V1_3.TaskWindowState
+import vendor.waydroid.window.V1_3.TaskWindowStateSource
+
+/** Keeps Android desktop-task state and the host xdg-toplevel state in one task-ID protocol. */
+internal class WaydroidTaskWindowStateBridge(
+    private val shellTaskOrganizer: ShellTaskOrganizer,
+    private val displayController: DisplayController,
+    private val userRepositories: DesktopUserRepositories,
+    private val mainExecutor: ShellExecutor,
+    private val desktopTasksController: DesktopTasksController,
+) {
+    private data class StateSnapshot(val state: Int, val restoreBounds: Rect)
+
+    private data class HostRequest(val state: Int, val generation: Long)
+
+    private data class HostBoundsRequest(
+        val taskId: Int,
+        val bounds: Rect,
+        val dragResizing: Boolean,
+        val generation: Long,
+    )
+
+    private var waydroidWindow: IWaydroidWindow? = null
+    private var reconnectScheduled = false
+    private val nextGeneration = AtomicLong(1)
+    private val lastPublishedByTaskId = mutableMapOf<Int, StateSnapshot>()
+    private val pendingHostRequestByTaskId = mutableMapOf<Int, HostRequest>()
+    private val hostBoundsLock = Any()
+    private val pendingHostBoundsByTaskId = mutableMapOf<Int, HostBoundsRequest>()
+    private var hostBoundsDrainScheduled = false
+    private val lastHostBoundsGenerationByTaskId = mutableMapOf<Int, Long>()
+    private val hostDragResizingTaskIds = mutableSetOf<Int>()
+
+    private val deathRecipient =
+        object : IHwBinder.DeathRecipient {
+            override fun serviceDied(cookie: Long) {
+                mainExecutor.execute {
+                    Slog.w(TAG, "Waydroid window state service died cookie=$cookie")
+                    waydroidWindow = null
+                    lastPublishedByTaskId.clear()
+                    lastHostBoundsGenerationByTaskId.clear()
+                    synchronized(hostBoundsLock) { pendingHostBoundsByTaskId.clear() }
+                    scheduleReconnect()
+                }
+            }
+        }
+
+    private val callback =
+        object : IWaydroidWindowCallback.Stub() {
+            override fun requestTaskWindowBounds(
+                taskID: Int,
+                bounds: TaskWindowBounds,
+                dragResizing: Boolean,
+                generation: Long,
+            ) {
+                enqueueHostBoundsRequest(
+                    HostBoundsRequest(
+                        taskId = taskID,
+                        bounds = Rect(bounds.left, bounds.top, bounds.right, bounds.bottom),
+                        dragResizing = dragResizing,
+                        generation = generation,
+                    )
+                )
+            }
+
+            override fun requestTaskWindowState(
+                taskID: Int,
+                state: Int,
+                bounds: TaskWindowBounds,
+                generation: Long,
+            ) {
+                mainExecutor.execute { handleHostRequest(taskID, state, generation) }
+            }
+
+            override fun queryTaskWindowState(taskID: Int) {
+                mainExecutor.execute { publishRequestedState(taskID) }
+            }
+        }
+
+    fun start() {
+        if (ensureService() == null) scheduleReconnect()
+    }
+
+    fun onTaskInfoChanged(taskInfo: RunningTaskInfo) {
+        if (taskInfo.windowingMode != WINDOWING_MODE_FREEFORM) {
+            hostDragResizingTaskIds.remove(taskInfo.taskId)
+            lastHostBoundsGenerationByTaskId.remove(taskInfo.taskId)
+            return
+        }
+        val pending = pendingHostRequestByTaskId[taskInfo.taskId]
+        if (pending == null) {
+            publishCurrentState(taskInfo)
+            return
+        }
+
+        val currentState = getCurrentState(taskInfo)
+        if (currentState == pending.state) {
+            publishCurrentState(
+                taskInfo,
+                source = TaskWindowStateSource.HOST,
+                generation = pending.generation,
+                force = true,
+            )
+            return
+        }
+
+        val repository = userRepositories.getProfile(taskInfo.userId)
+        if (
+            pending.state == TaskWindowState.MAXIMIZED &&
+                currentState == TaskWindowState.NORMAL &&
+                !repository.isMinimizedTask(taskInfo.taskId)
+        ) {
+            desktopTasksController.toggleDesktopTaskSize(
+                taskInfo,
+                ToggleTaskSizeInteraction(
+                    direction = ToggleTaskSizeInteraction.Direction.MAXIMIZE,
+                    source = ToggleTaskSizeInteraction.Source.KEYBOARD_SHORTCUT,
+                    inputMethod = InputMethod.MOUSE,
+                ),
+            )
+        }
+    }
+
+    fun onTaskMinimized(taskInfo: RunningTaskInfo) {
+        publishRequestedAndroidState(
+            taskInfo,
+            TaskWindowState.MINIMIZED,
+            taskInfo.configuration.windowConfiguration.bounds,
+        )
+    }
+
+    fun onTaskSizeToggled(
+        taskInfo: RunningTaskInfo,
+        maximized: Boolean,
+        restoreBounds: Rect,
+    ) {
+        publishRequestedAndroidState(
+            taskInfo,
+            if (maximized) TaskWindowState.MAXIMIZED else TaskWindowState.NORMAL,
+            if (maximized) restoreBounds else Rect(),
+        )
+    }
+
+    private fun enqueueHostBoundsRequest(request: HostBoundsRequest) {
+        if (
+            request.taskId <= 0 ||
+                request.generation <= 0 ||
+                request.bounds.width() <= 0 ||
+                request.bounds.height() <= 0
+        ) {
+            Slog.w(
+                TAG,
+                "Ignoring malformed host bounds task=${request.taskId} " +
+                    "bounds=${request.bounds} gen=${request.generation}",
+            )
+            return
+        }
+
+        var scheduleDrain = false
+        synchronized(hostBoundsLock) {
+            val pending = pendingHostBoundsByTaskId[request.taskId]
+            if (pending == null || request.generation > pending.generation) {
+                pendingHostBoundsByTaskId[request.taskId] = request
+            }
+            if (!hostBoundsDrainScheduled) {
+                hostBoundsDrainScheduled = true
+                scheduleDrain = true
+            }
+        }
+        if (scheduleDrain) mainExecutor.execute { drainHostBoundsRequests() }
+    }
+
+    private fun drainHostBoundsRequests() {
+        val requests =
+            synchronized(hostBoundsLock) {
+                val drained = pendingHostBoundsByTaskId.values.toList()
+                pendingHostBoundsByTaskId.clear()
+                hostBoundsDrainScheduled = false
+                drained
+            }
+        requests.forEach(::applyHostBoundsRequest)
+    }
+
+    private fun applyHostBoundsRequest(request: HostBoundsRequest) {
+        val lastGeneration = lastHostBoundsGenerationByTaskId[request.taskId] ?: 0
+        if (request.generation <= lastGeneration) return
+
+        val taskInfo = shellTaskOrganizer.getRunningTaskInfo(request.taskId)
+        if (taskInfo == null || taskInfo.windowingMode != WINDOWING_MODE_FREEFORM) {
+            hostDragResizingTaskIds.remove(request.taskId)
+            lastHostBoundsGenerationByTaskId[request.taskId] = request.generation
+            return
+        }
+
+        val currentBounds = taskInfo.configuration.windowConfiguration.bounds
+        val wasDragResizing = request.taskId in hostDragResizingTaskIds
+        if (currentBounds == request.bounds && wasDragResizing == request.dragResizing) {
+            lastHostBoundsGenerationByTaskId[request.taskId] = request.generation
+            return
+        }
+
+        val wct = WindowContainerTransaction()
+        if (wasDragResizing != request.dragResizing) {
+            wct.setDragResizing(taskInfo.token, request.dragResizing)
+        }
+        if (currentBounds != request.bounds) {
+            wct.setBounds(taskInfo.token, request.bounds)
+        }
+        shellTaskOrganizer.applyTransaction(wct)
+        if (request.dragResizing) {
+            hostDragResizingTaskIds.add(request.taskId)
+        } else {
+            hostDragResizingTaskIds.remove(request.taskId)
+        }
+        lastHostBoundsGenerationByTaskId[request.taskId] = request.generation
+    }
+
+    private fun handleHostRequest(taskId: Int, state: Int, generation: Long) {
+        if (
+            taskId <= 0 ||
+                generation <= 0 ||
+                state !in
+                    setOf(
+                        TaskWindowState.NORMAL,
+                        TaskWindowState.MAXIMIZED,
+                        TaskWindowState.MINIMIZED,
+                    )
+        ) {
+            Slog.w(TAG, "Ignoring malformed host state task=$taskId state=$state gen=$generation")
+            return
+        }
+        val taskInfo = shellTaskOrganizer.getRunningTaskInfo(taskId) ?: return
+        if (taskInfo.windowingMode != WINDOWING_MODE_FREEFORM) return
+        pendingHostRequestByTaskId[taskId] = HostRequest(state, generation)
+
+        val currentState = getCurrentState(taskInfo)
+        if (currentState == state) {
+            publishCurrentState(
+                taskInfo,
+                source = TaskWindowStateSource.HOST,
+                generation = generation,
+                force = true,
+            )
+            return
+        }
+
+        val repository = userRepositories.getProfile(taskInfo.userId)
+        when (state) {
+            TaskWindowState.MINIMIZED ->
+                desktopTasksController.minimizeTask(taskInfo, MinimizeReason.KEY_GESTURE)
+            TaskWindowState.NORMAL ->
+                if (repository.isMinimizedTask(taskId)) {
+                    desktopTasksController.moveTaskToFront(
+                        taskInfo,
+                        unminimizeReason = UnminimizeReason.UNKNOWN,
+                    )
+                } else {
+                    desktopTasksController.toggleDesktopTaskSize(
+                        taskInfo,
+                        ToggleTaskSizeInteraction(
+                            direction = ToggleTaskSizeInteraction.Direction.RESTORE,
+                            source = ToggleTaskSizeInteraction.Source.KEYBOARD_SHORTCUT,
+                            inputMethod = InputMethod.MOUSE,
+                        ),
+                    )
+                }
+            TaskWindowState.MAXIMIZED ->
+                if (repository.isMinimizedTask(taskId)) {
+                    desktopTasksController.moveTaskToFront(
+                        taskInfo,
+                        unminimizeReason = UnminimizeReason.UNKNOWN,
+                    )
+                } else {
+                    desktopTasksController.toggleDesktopTaskSize(
+                        taskInfo,
+                        ToggleTaskSizeInteraction(
+                            direction = ToggleTaskSizeInteraction.Direction.MAXIMIZE,
+                            source = ToggleTaskSizeInteraction.Source.KEYBOARD_SHORTCUT,
+                            inputMethod = InputMethod.MOUSE,
+                        ),
+                    )
+                }
+        }
+    }
+
+    private fun publishRequestedState(taskId: Int) {
+        val tasks =
+            if (taskId == 0) shellTaskOrganizer.getRunningTasks()
+            else listOfNotNull(shellTaskOrganizer.getRunningTaskInfo(taskId))
+        for (taskInfo in tasks) {
+            if (taskInfo.windowingMode == WINDOWING_MODE_FREEFORM) {
+                publishCurrentState(
+                    taskInfo,
+                    source = TaskWindowStateSource.RECONCILE,
+                    generation = nextGeneration.getAndIncrement(),
+                    force = true,
+                )
+            }
+        }
+    }
+
+    private fun publishRequestedAndroidState(
+        taskInfo: RunningTaskInfo,
+        state: Int,
+        restoreBounds: Rect,
+    ) {
+        val hostRequest = pendingHostRequestByTaskId[taskInfo.taskId]
+        if (hostRequest?.state == state) {
+            publishState(
+                taskInfo.taskId,
+                state,
+                restoreBounds,
+                TaskWindowStateSource.HOST,
+                hostRequest.generation,
+                force = true,
+            )
+        } else {
+            publishState(
+                taskInfo.taskId,
+                state,
+                restoreBounds,
+                TaskWindowStateSource.ANDROID_FRAMEWORK,
+                nextGeneration.getAndIncrement(),
+            )
+        }
+    }
+
+    private fun publishCurrentState(
+        taskInfo: RunningTaskInfo,
+        source: Int = TaskWindowStateSource.ANDROID_FRAMEWORK,
+        generation: Long = nextGeneration.getAndIncrement(),
+        force: Boolean = false,
+    ) {
+        val repository = userRepositories.getProfile(taskInfo.userId)
+        val state = getCurrentState(taskInfo)
+        val taskBounds = taskInfo.configuration.windowConfiguration.bounds
+        val restoreBounds =
+            when (state) {
+                TaskWindowState.MAXIMIZED ->
+                    repository.getBoundsBeforeMaximize(taskInfo.taskId) ?: taskBounds
+                TaskWindowState.MINIMIZED -> taskBounds
+                else -> Rect()
+            }
+        publishState(
+            taskInfo.taskId,
+            state,
+            restoreBounds,
+            source,
+            generation,
+            force,
+        )
+    }
+
+    private fun getCurrentState(taskInfo: RunningTaskInfo): Int {
+        val repository = userRepositories.getProfile(taskInfo.userId)
+        if (repository.isMinimizedTask(taskInfo.taskId)) return TaskWindowState.MINIMIZED
+        val displayLayout = displayController.getDisplayLayout(taskInfo.displayId)
+        return if (
+            repository.getBoundsBeforeMaximize(taskInfo.taskId) != null ||
+                (displayLayout != null && isTaskMaximized(taskInfo, displayLayout))
+        ) {
+            TaskWindowState.MAXIMIZED
+        } else {
+            TaskWindowState.NORMAL
+        }
+    }
+
+    private fun publishState(
+        taskId: Int,
+        state: Int,
+        restoreBounds: Rect,
+        source: Int,
+        generation: Long,
+        force: Boolean = false,
+    ) {
+        val snapshot = StateSnapshot(state, Rect(restoreBounds))
+        if (!force && lastPublishedByTaskId[taskId] == snapshot) return
+        val service = ensureService()
+        if (service == null) {
+            scheduleReconnect()
+            return
+        }
+        val bounds =
+            TaskWindowBounds().apply {
+                left = restoreBounds.left
+                top = restoreBounds.top
+                right = restoreBounds.right
+                bottom = restoreBounds.bottom
+            }
+        try {
+            if (service.setTaskWindowState(taskId, state, bounds, source, generation)) {
+                lastPublishedByTaskId[taskId] = snapshot
+                if (source == TaskWindowStateSource.HOST) {
+                    pendingHostRequestByTaskId.remove(taskId)
+                }
+            } else {
+                Slog.w(TAG, "Waydroid rejected task=$taskId state=$state gen=$generation")
+            }
+        } catch (e: RemoteException) {
+            Slog.w(TAG, "Failed to publish task=$taskId state=$state", e)
+            waydroidWindow = null
+            lastPublishedByTaskId.clear()
+            scheduleReconnect()
+        }
+    }
+
+    private fun ensureService(): IWaydroidWindow? {
+        waydroidWindow?.let { return it }
+        return try {
+            val service = IWaydroidWindow.getService(false)
+            if (!service.linkToDeath(deathRecipient, DEATH_COOKIE)) {
+                Slog.w(TAG, "Failed to link Waydroid window state death recipient")
+                null
+            } else if (!service.registerTaskWindowCallback(callback)) {
+                Slog.w(TAG, "Failed to register Waydroid window state callback")
+                null
+            } else {
+                lastPublishedByTaskId.clear()
+                lastHostBoundsGenerationByTaskId.clear()
+                waydroidWindow = service
+                service
+            }
+        } catch (e: NoSuchElementException) {
+            null
+        } catch (e: RemoteException) {
+            Slog.w(TAG, "Failed to connect Waydroid window state service", e)
+            null
+        }
+    }
+
+    private fun scheduleReconnect() {
+        if (reconnectScheduled) return
+        reconnectScheduled = true
+        mainExecutor.executeDelayed(
+            {
+                reconnectScheduled = false
+                if (ensureService() == null) scheduleReconnect()
+            },
+            RECONNECT_DELAY_MS,
+        )
+    }
+
+    private companion object {
+        const val TAG = "WaydroidTaskWindowState"
+        const val DEATH_COOKIE = 0x57494E44L
+        const val RECONNECT_DELAY_MS = 2_000L
+    }
+}
