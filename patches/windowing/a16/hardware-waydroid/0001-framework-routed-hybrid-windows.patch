+
+bool display::queue_task_window_state(const task_window_state_update &update) {
+    if (update.generation == 0
+            || (update.task_id == 0
+                && update.state != waydroid_task_window_state::FullUi)
+            || (update.task_id != 0
+                && update.state == waydroid_task_window_state::FullUi)) {
+        return false;
+    }
+    if (update.task_id != 0) {
+        task_window_route route;
+        if (!get_task_window_route(update.task_id, &route) || !route.enabled)
+            return false;
+    }
+    {
+        std::scoped_lock lock(task_window_state_mutex);
+        pending_task_window_states[update.task_id] = update;
+        task_window_states[update.task_id] = update;
+    }
+    if (procs && procs->invalidate)
+        procs->invalidate(procs);
+    return true;
+}
