+
+static bool parse_numeric_task_id(const std::string &task_id_text,
+        uint32_t *task_id) {
+    if (!task_id || task_id_text.empty()
+            || task_id_text.find_first_not_of("0123456789")
+                    != std::string::npos) {
+        return false;
+    }
+    char *task_end = nullptr;
+    errno = 0;
+    const unsigned long parsed = std::strtoul(
+            task_id_text.c_str(), &task_end, 10);
+    if (errno != 0 || task_end == task_id_text.c_str() || *task_end != '\0'
+            || parsed == 0 || parsed > INT32_MAX) {
+        return false;
+    }
+    *task_id = static_cast<uint32_t>(parsed);
+    return true;
+}
+
+bool window::get_numeric_task_id(uint32_t *task_id) const {
+    return parse_numeric_task_id(taskID, task_id);
+}
+
+void window::queue_task_configure(int32_t width, int32_t height,
+        bool drag_resizing, bool state_transition) {
+    if (width > 1 && height > 1) {
+        last_queued_task_configure_width = width;
+        last_queued_task_configure_height = height;
+    } else {
+        // xdg-shell permits 0x0 when the compositor leaves size choice
+        // to the client.  Mutter uses that form for the final configure
+        // after dropping XDG_TOPLEVEL_STATE_RESIZING.
+        width = last_queued_task_configure_width;
+        height = last_queued_task_configure_height;
+        if (width <= 1 || height <= 1)
+            return;
+    }
+    const uint32_t packed_height = static_cast<uint32_t>(height)
+            | (drag_resizing ? UINT32_C(0x80000000) : 0)
+            | (state_transition ? UINT32_C(0x40000000) : 0);
+    const uint64_t size =
+            (static_cast<uint64_t>(static_cast<uint32_t>(width)) << 32) |
+            packed_height;
+    pending_task_configure_size.store(size, std::memory_order_release);
+}
+
+bool window::take_task_configure(int32_t *width, int32_t *height) {
+    const uint64_t size = pending_task_configure_size.exchange(
+            0, std::memory_order_acquire);
+    if (size == 0)
+        return false;
+    const uint32_t packed_height = static_cast<uint32_t>(size);
+    *width = static_cast<int32_t>(size >> 32);
+    *height = static_cast<int32_t>(packed_height & UINT32_C(0x3fffffff));
+    taken_task_drag_resizing =
+            (packed_height & UINT32_C(0x80000000)) != 0;
+    taken_task_state_transition =
+            (packed_height & UINT32_C(0x40000000)) != 0;
+    return *width > 1 && *height > 1;
+}
+
+bool window::host_carrier_configured() const {
+    return host_carrier_width > 1 && host_carrier_height > 1;
+}
+
+void window::apply_task_carrier_configure(int32_t width, int32_t height) {
+    if (width <= 1 || height <= 1)
+        return;
+    host_carrier_width = width;
+    host_carrier_height = height;
+    if (input_region) {
+        wl_region_subtract(input_region, 0, 0, INT_MAX, INT_MAX);
+        wl_region_add(input_region, 0, 0, width, height);
+        wl_surface_set_input_region(surface, input_region);
+    }
+    if (xdg_surface)
+        xdg_surface_set_window_geometry(xdg_surface, 0, 0, width, height);
+    if (dedicated_background_surface && viewport)
+        wp_viewport_set_destination(viewport, width, height);
+    wl_surface_damage(surface, 0, 0, INT32_MAX, INT32_MAX);
+    ALOGI("TASK_XDG_CONFIGURE task=%s carrier=%dx%d"
+            " android=%d,%d-%d,%d drag_resizing=%d",
+            taskID.c_str(), width, height, task_left, task_top,
+            task_right, task_bottom, taken_task_drag_resizing);
+}
+
+void window::handle_task_configure(int32_t width, int32_t height) {
+    if (!task_resize_enabled || width <= 1 || height <= 1)
+        return;
+    const bool drag_resizing = taken_task_drag_resizing;
+    const bool host_geometry_authoritative = drag_resizing
+            || host_drag_resizing || taken_task_state_transition;
+    if (!host_geometry_authoritative) {
+        ALOGI("TASK_XDG_CONFIGURE task=%s carrier=unchanged"
+                " suggestion=%dx%d reason=ordinary-configure",
+                taskID.c_str(), width, height);
+        return;
+    }
+    apply_task_carrier_configure(width, height);
+    const int physical_width = std::max(1, static_cast<int>(ceil(width * display->scale)));
+    const int physical_height = std::max(1, static_cast<int>(ceil(height * display->scale)));
+    const bool host_size_changed = physical_width != last_host_configure_width
+            || physical_height != last_host_configure_height;
+    const bool drag_state_changed = drag_resizing != host_drag_resizing;
+    if (!host_size_changed && !drag_state_changed)
+        return;
+    if (physical_width == last_task_resize_width
+            && physical_height == last_task_resize_height
+            && !drag_state_changed) {
+        last_host_configure_width = physical_width;
+        last_host_configure_height = physical_height;
+        return;
+    }
+    uint32_t parsed_task = 0;
+    if (!get_numeric_task_id(&parsed_task)) {
+        ALOGE("ignoring configure for malformed task id %s", taskID.c_str());
+        return;
+    }
+    const task_window_bounds bounds = {task_left, task_top,
+            task_left + physical_width, task_top + physical_height};
+    const uint64_t generation = display->enqueue_task_window_bounds_request(
+            parsed_task, bounds, drag_resizing);
+    if (generation == 0)
+        return;
+    last_host_configure_width = physical_width;
+    last_host_configure_height = physical_height;
+    host_drag_resizing = drag_resizing;
+    ALOGI("task %s queues host bounds generation=%" PRIu64
+            " drag_resizing=%d %dx%d -> Android bounds %d,%d-%d,%d",
+            taskID.c_str(), generation, drag_resizing, width, height,
+            bounds.left, bounds.top, bounds.right, bounds.bottom);
+}
+
+void window::apply_task_window_state(const task_window_state_update &update) {
+    requested_task_window_state = update.state;
+    requested_task_window_generation = update.generation;
+    if (update.source == waydroid_task_window_state_source::Host)
+        host_task_window_state_request_pending = false;
+    switch (update.state) {
+        case waydroid_task_window_state::Normal:
+            set_maximize(false);
+            task_window_state_ack_pending = xdg_toplevel != nullptr;
+            break;
+        case waydroid_task_window_state::Maximized:
+            set_maximize(true);
+            task_window_state_ack_pending = xdg_toplevel != nullptr;
+            break;
+        case waydroid_task_window_state::Minimized:
+            minimize();
+            observed_task_window_state = waydroid_task_window_state::Minimized;
+            task_window_state_ack_pending = false;
+            break;
+        case waydroid_task_window_state::FullUi:
+            if (taskID == "0")
+                set_maximize(true);
+            task_window_state_ack_pending = false;
+            break;
     }
+    ALOGI("task %s applies window state=%u source=%u generation=%" PRIu64,
+            taskID.c_str(), static_cast<uint32_t>(update.state),
+            static_cast<uint32_t>(update.source), update.generation);
+}
+
+bool window::observe_task_window_state(waydroid_task_window_state state,
+        bool activated) {
+    if (task_window_state_ack_pending && state == requested_task_window_state) {
+        observed_task_window_state = state;
+        task_window_state_ack_pending = false;
+        ALOGI("task %s acks window state=%u generation=%" PRIu64,
+                taskID.c_str(), static_cast<uint32_t>(state),
+                requested_task_window_generation);
+        return false;
+    }
+    if (state == observed_task_window_state)
+        return false;
+    // xdg-shell has no minimized state.  Some compositors send an
+    // unactivated normal configure while honoring set_minimized(); only an
+    // activated configure is evidence that the host restored the window.
+    if (observed_task_window_state == waydroid_task_window_state::Minimized
+            && state == waydroid_task_window_state::Normal && !activated) {
+        return false;
+    }
+    observed_task_window_state = state;
+    task_window_state_ack_pending = false;
+    host_task_window_state_request_pending = true;
+    return true;
 }
 
