+
+void display::retire_window(std::unique_ptr<window> retired) {
+    if (!retired)
+        return;
+    bool request_sync = false;
+    {
+        std::scoped_lock lock(retired_windows_mutex);
+        retired_windows.push_back(std::move(retired));
+        if (!retirement_sync_pending) {
