+static bool execute_task_command(struct display *display,
+        sp<IWaydroidTask> &task, const task_command &command) {
+    if (command.type == task_command_type::WindowBoundsRequest
+            || command.type == task_command_type::WindowStateRequest
+            || command.type == task_command_type::WindowStateQuery) {
+        return display->notify_task_window_state(command);
+    }
+    if (task == nullptr)
+        task = IWaydroidTask::getService();
+    if (task == nullptr) {
+        ALOGE("task command generation=%" PRIu64 " has no HAL service",
+                command.generation);
+        return false;
+    }
+    switch (command.type) {
+        case task_command_type::Focus: {
+            const auto result = task->setFocusedTask(command.task_id);
+            return result.isOk();
+        }
+        case task_command_type::Remove: {
+            const auto result = task->removeTask(command.task_id);
+            return result.isOk();
+        }
+        case task_command_type::Resize: {
+            const auto result = task->resizeTask(command.task_id, command.left,
+                    command.top, command.right, command.bottom,
+                    command.resize_mode);
+            if (!result.isOk())
+                return false;
+            if (!result.withDefault(false))
+                ALOGE("task %u resize generation=%" PRIu64 " rejected",
+                        command.task_id, command.generation);
+            return true;
+        }
+        case task_command_type::WindowBoundsRequest:
+        case task_command_type::WindowStateRequest:
+        case task_command_type::WindowStateQuery:
+            break;
+    }
+    return true;
+}
+
+static void *task_command_worker(void *data) {
+    auto *display = static_cast<struct display *>(data);
+    sp<IWaydroidTask> task = display->task;
+    while (true) {
+        task_command command;
+        {
+            std::unique_lock lock(display->task_command_mutex);
+            display->task_command_cv.wait(lock, [&](){
+                return display->task_command_stop
+                        || !display->task_commands.empty();
+            });
+            if (display->task_command_stop && display->task_commands.empty())
+                break;
+            command = display->task_commands.front();
+            display->task_commands.pop_front();
+        }
+        bool completed = false;
+        for (int attempt = 0; attempt < 2 && !completed; ++attempt) {
+            completed = execute_task_command(display, task, command);
+            if (!completed)
+                task = nullptr;
+        }
+        if (!completed)
+            ALOGE("task command generation=%" PRIu64 " failed twice",
+                    command.generation);
+    }
+    return nullptr;
+}
+
+void display::start_task_command_worker() {
+    task_command_stop = false;
+    const int result = pthread_create(&task_command_thread, nullptr,
+            task_command_worker, this);
+    if (result != 0) {
+        ALOGE("failed to start task-command worker: %s", strerror(result));
+        return;
+    }
+    task_command_thread_started = true;
+}
+
+void display::stop_task_command_worker() {
+    if (!task_command_thread_started)
+        return;
+    {
+        std::scoped_lock lock(task_command_mutex);
+        task_command_stop = true;
+    }
+    task_command_cv.notify_one();
+    pthread_join(task_command_thread, nullptr);
+    task_command_thread_started = false;
+}
+
+static uint64_t enqueue_task_command(struct display *display,
+        task_command command) {
+    command.generation = display->next_task_command_generation.fetch_add(
+            1, std::memory_order_relaxed);
+    {
+        std::scoped_lock lock(display->task_command_mutex);
+        if (!display->task_command_thread_started || display->task_command_stop) {
+            ALOGE("dropping task command generation=%" PRIu64
+                    " because worker is stopped", command.generation);
+            return 0;
+        }
+        auto &commands = display->task_commands;
+        if (command.type == task_command_type::Resize) {
+            for (auto it = commands.rbegin(); it != commands.rend(); ++it) {
+                if (it->type == task_command_type::Resize
+                        && it->task_id == command.task_id) {
+                    *it = command;
+                    display->task_command_cv.notify_one();
+                    return command.generation;
+                }
+            }
+        } else if (command.type == task_command_type::Focus) {
+            commands.erase(std::remove_if(commands.begin(), commands.end(),
+                    [](const task_command &queued) {
+                        return queued.type == task_command_type::Focus;
+                    }), commands.end());
+        } else if (command.type == task_command_type::Remove) {
+            commands.erase(std::remove_if(commands.begin(), commands.end(),
+                    [&](const task_command &queued) {
+                        return queued.task_id == command.task_id
+                                && (queued.type == task_command_type::Focus
+                                    || queued.type == task_command_type::Resize);
+                    }), commands.end());
+        } else if (command.type == task_command_type::WindowBoundsRequest) {
+            commands.erase(std::remove_if(commands.begin(), commands.end(),
+                    [&](const task_command &queued) {
+                        return queued.type == task_command_type::WindowBoundsRequest
+                                && queued.task_id == command.task_id;
+                    }), commands.end());
+        } else if (command.type == task_command_type::WindowStateRequest) {
+            commands.erase(std::remove_if(commands.begin(), commands.end(),
+                    [&](const task_command &queued) {
+                        return queued.type == task_command_type::WindowStateRequest
+                                && queued.task_id == command.task_id;
+                    }), commands.end());
+        } else if (command.type == task_command_type::WindowStateQuery) {
+            commands.erase(std::remove_if(commands.begin(), commands.end(),
+                    [&](const task_command &queued) {
+                        return queued.type == task_command_type::WindowStateQuery
+                                && queued.task_id == command.task_id;
+                    }), commands.end());
+        }
+        commands.push_back(command);
+    }
+    display->task_command_cv.notify_one();
+    return command.generation;
+}
+
+uint64_t display::enqueue_task_focus(uint32_t task_id) {
+    task_command command;
+    command.type = task_command_type::Focus;
+    command.task_id = task_id;
+    return enqueue_task_command(this, command);
+}
