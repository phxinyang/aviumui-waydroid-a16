+// Methods from ::vendor::waydroid::window::V1_3::IWaydroidWindow follow.
+Return<bool> WaydroidWindow::registerTaskWindowCallback(
+        const sp<IWaydroidWindowCallback>& callback) {
+    if (callback == nullptr)
+        return false;
+    {
+        std::scoped_lock lock(mTaskWindowCallbackMutex);
+        mTaskWindowCallback = callback;
+    }
+    // A new framework callback is authoritative. Drop routes from a previous
+    // SystemUI generation before it republishes the current TaskInfo set.
+    mDisplay->clear_task_window_routes();
+    mDisplay->enqueue_task_window_state_query(0);
+    return true;
+}
+
+Return<bool> WaydroidWindow::beginTaskWindowDrag(uint32_t taskID,
+        hidl_bitfield<TaskWindowDragEdge> edges) {
+    return mDisplay->begin_task_window_drag(
+            taskID, static_cast<uint32_t>(edges));
+}
+
+Return<bool> WaydroidWindow::setTaskWindowRoute(uint32_t taskID, bool enabled,
+        int32_t displayID, const hidl_string& component,
+        const hidl_string& title, const hidl_string& appID) {
+    task_window_route route;
+    route.enabled = enabled;
+    route.display_id = displayID;
+    route.component = component.c_str();
+    route.title = title.c_str();
+    route.app_id = appID.c_str();
+    return mDisplay->set_task_window_route(taskID, route);
+}
+
+Return<bool> WaydroidWindow::setTaskWindowState(uint32_t taskID,
+        TaskWindowState state, const TaskWindowBounds& restoreBounds,
+        TaskWindowStateSource source, uint64_t generation) {
+    task_window_state_update update;
+    update.task_id = taskID;
+    update.restore_bounds = {restoreBounds.left, restoreBounds.top,
+            restoreBounds.right, restoreBounds.bottom};
+    update.generation = generation;
+    switch (state) {
+        case TaskWindowState::NORMAL:
+            update.state = waydroid_task_window_state::Normal;
+            break;
+        case TaskWindowState::MAXIMIZED:
+            update.state = waydroid_task_window_state::Maximized;
+            break;
+        case TaskWindowState::MINIMIZED:
+            update.state = waydroid_task_window_state::Minimized;
+            break;
+        case TaskWindowState::FULL_UI:
+            update.state = waydroid_task_window_state::FullUi;
+            break;
+        default:
+            return false;
+    }
+    switch (source) {
+        case TaskWindowStateSource::ANDROID_FRAMEWORK:
+            update.source = waydroid_task_window_state_source::Android;
+            break;
+        case TaskWindowStateSource::HOST:
+            update.source = waydroid_task_window_state_source::Host;
+            break;
+        case TaskWindowStateSource::RECONCILE:
+            update.source = waydroid_task_window_state_source::Reconcile;
+            break;
+        default:
+            return false;
+    }
+    return mDisplay->queue_task_window_state(update);
+}
+
+bool WaydroidWindow::notifyTaskWindowState(const task_command& command) {
+    sp<IWaydroidWindowCallback> callback;
+    {
+        std::scoped_lock lock(mTaskWindowCallbackMutex);
+        callback = mTaskWindowCallback;
+    }
+    if (callback == nullptr)
+        return false;
+
+    Return<void> result;
+    if (command.type == task_command_type::WindowStateQuery) {
+        result = callback->queryTaskWindowState(command.task_id);
+    } else if (command.type == task_command_type::WindowBoundsRequest) {
+        TaskWindowBounds bounds;
+        bounds.left = command.window_bounds.left;
+        bounds.top = command.window_bounds.top;
+        bounds.right = command.window_bounds.right;
+        bounds.bottom = command.window_bounds.bottom;
+        result = callback->requestTaskWindowBounds(command.task_id, bounds,
+                command.drag_resizing, command.generation);
+    } else if (command.type == task_command_type::WindowStateRequest) {
+        TaskWindowBounds bounds;
+        bounds.left = command.window_bounds.left;
+        bounds.top = command.window_bounds.top;
+        bounds.right = command.window_bounds.right;
+        bounds.bottom = command.window_bounds.bottom;
+        TaskWindowState state = TaskWindowState::NORMAL;
+        switch (command.window_state) {
+            case waydroid_task_window_state::Normal:
+                state = TaskWindowState::NORMAL;
+                break;
+            case waydroid_task_window_state::Maximized:
+                state = TaskWindowState::MAXIMIZED;
+                break;
+            case waydroid_task_window_state::Minimized:
+                state = TaskWindowState::MINIMIZED;
+                break;
+            case waydroid_task_window_state::FullUi:
+                state = TaskWindowState::FULL_UI;
+                break;
+        }
+        result = callback->requestTaskWindowState(command.task_id, state,
+                bounds, command.generation);
+    } else {
+        return false;
+    }
+    if (result.isOk())
+        return true;
+    ALOGE("task-window callback failed: %s", result.description().c_str());
+    {
+        std::scoped_lock lock(mTaskWindowCallbackMutex);
+        if (mTaskWindowCallback == callback)
+            mTaskWindowCallback = nullptr;
+    }
+    return false;
+}
+
 }  // namespace vendor::waydroid::window::implementation
