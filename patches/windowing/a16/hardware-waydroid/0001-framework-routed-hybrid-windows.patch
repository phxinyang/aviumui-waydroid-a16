+static struct window *find_window_for_identity(display *display,
+        const std::string &identity, bool fallback_to_full_ui) {
+    struct window *full_ui = nullptr;
+    for (auto& [id, candidate] : display->windows) {
+        if (!candidate)
+            continue;
+        if (candidate->taskID == "0") {
+            full_ui = candidate.get();
+            continue;
+        }
+        if (candidate->taskID == identity || candidate->appID == identity)
+            return candidate.get();
+    }
+    return fallback_to_full_ui ? full_ui : nullptr;
+}
