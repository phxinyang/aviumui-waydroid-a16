+    @Test
+    public void testWaydroidHostWindowRoute_trustedSystemCookie() {
+        final ActivityStarter starter = prepareStarter(FLAG_ACTIVITY_NEW_TASK, false);
+        new ActivityBuilder(mAtm).setCreateTask(true).build();
+        final ActivityOptions options = ActivityOptions.makeBasic();
+        final Binder cookie = new Binder("com.avium.waydroid.launch.HOST_WINDOW");
+        options.setLaunchCookie(cookie);
+        final Intent intent = new Intent();
+        intent.setComponent(ActivityBuilder.getDefaultComponent());
+
+        starter.setReason("testWaydroidHostWindowRoute_trustedSystemCookie")
+                .setIntent(intent)
+                .setCallingUid(SYSTEM_UID)
+                .setActivityOptions(options.toBundle(), Binder.getCallingPid(), SYSTEM_UID)
+                .execute();
+
+        assertTrue(mRootWindowContainer.topRunningActivity().mLaunchCookie == cookie);
+        assertTrue(mRootWindowContainer.topRunningActivity().getTask()
+                .isWaydroidHostWindow());
+    }
+
+    @Test
+    public void testWaydroidHostWindowRoute_rejectsWrongDescriptor() {
+        final ActivityStarter starter = prepareStarter(FLAG_ACTIVITY_NEW_TASK, false);
+        new ActivityBuilder(mAtm).setCreateTask(true).build();
+        final ActivityOptions options = ActivityOptions.makeBasic();
+        final Binder cookie = new Binder("com.example.NOT_A_HOST_WINDOW");
+        options.setLaunchCookie(cookie);
+        final Intent intent = new Intent();
+        intent.setComponent(ActivityBuilder.getDefaultComponent());
+
+        starter.setReason("testWaydroidHostWindowRoute_rejectsWrongDescriptor")
+                .setIntent(intent)
+                .setCallingUid(SYSTEM_UID)
+                .setActivityOptions(options.toBundle(), Binder.getCallingPid(), SYSTEM_UID)
+                .execute();
+
+        assertTrue(mRootWindowContainer.topRunningActivity().mLaunchCookie == cookie);
+        assertFalse(mRootWindowContainer.topRunningActivity().getTask()
+                .isWaydroidHostWindow());
+    }
+
+    @Test
+    public void testWaydroidHostWindowRoute_rejectsNonSystemCaller() {
+        final ActivityStarter starter = prepareStarter(FLAG_ACTIVITY_NEW_TASK, false);
+        new ActivityBuilder(mAtm).setCreateTask(true).build();
+        final ActivityOptions options = ActivityOptions.makeBasic();
+        final Binder cookie = new Binder("com.avium.waydroid.launch.HOST_WINDOW");
+        options.setLaunchCookie(cookie);
+        final Intent intent = new Intent();
+        intent.setComponent(ActivityBuilder.getDefaultComponent());
+
+        starter.setReason("testWaydroidHostWindowRoute_rejectsNonSystemCaller")
+                .setIntent(intent)
+                .setCallingUid(DEFAULT_FAKE_UID)
+                .setActivityOptions(
+                        options.toBundle(), Binder.getCallingPid(), DEFAULT_FAKE_UID)
+                .execute();
+
+        assertTrue(mRootWindowContainer.topRunningActivity().mLaunchCookie == cookie);
+        assertFalse(mRootWindowContainer.topRunningActivity().getTask()
+                .isWaydroidHostWindow());
+    }
