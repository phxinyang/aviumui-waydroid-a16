From 6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a Mon Sep 17 00:00:00 2001
From: Avium A16 Reproducer <avium-a16-reproducer@example.invalid>
Date: Wed, 12 Aug 2026 01:20:00 +0000
Subject: [PATCH] wm: keep non-host default-display launches fullscreen

While host-routed desktop tasks are active, the default display's "Desk"
root is in freeform mode, so an Android-internal launch (no trusted host
cookie) was being created freeform on the desk instead of staying fullscreen.
This broke the three-entry coexistence contract: Avium Launcher / Android
internal launches must keep AviumUI's default fullscreen even while Linux
host windows are open.

updateWaydroidHostWindowRoute now owns the full route policy for the default
display:

- trusted host launches (and same-task navigation into a host task) stay
  freeform on the desk;
- every other default-display launch that would enter Waydroid freeform
  windowing (the launch itself or its root is freeform) is taken out of the
  freeform desk root, reparented to the task display area and forced to
  fullscreen;
- normal Android fullscreen / multi-window (split) launches are untouched;
- non-default displays (Avium/MiFreeform) are never touched.

diff --git a/services/core/java/com/android/server/wm/ActivityStarter.java b/services/core/java/com/android/server/wm/ActivityStarter.java
index c4437d316415..d6ffe104ad8c 100644
--- a/services/core/java/com/android/server/wm/ActivityStarter.java
+++ b/services/core/java/com/android/server/wm/ActivityStarter.java
@@ -31,6 +31,7 @@ import static android.app.ActivityManager.isStartResultSuccessful;
 import static android.app.ActivityTaskManager.INVALID_TASK_ID;
 import static android.app.PendingIntent.FLAG_CANCEL_CURRENT;
 import static android.app.PendingIntent.FLAG_ONE_SHOT;
+import static android.app.WindowConfiguration.WINDOWING_MODE_FREEFORM;
 import static android.app.WindowConfiguration.WINDOWING_MODE_FULLSCREEN;
 import static android.app.WindowConfiguration.WINDOWING_MODE_PINNED;
 import static android.app.WindowConfiguration.WINDOWING_MODE_UNDEFINED;
@@ -1967,18 +1968,50 @@ class ActivityStarter {
         final boolean sameTaskNavigation = mSourceRecord != null
                 && mSourceRecord.getTask() == task;
         final boolean trustedHostLaunch = hasTrustedWaydroidHostWindowCookie();
-        final boolean routeToHostWindow = task.getDisplayId() == DEFAULT_DISPLAY
+        final boolean defaultDisplay = task.getDisplayId() == DEFAULT_DISPLAY;
+        final boolean routeToHostWindow = defaultDisplay
                 && (trustedHostLaunch
                     || (sameTaskNavigation && task.isWaydroidHostWindow()));
         final boolean wasHostWindow = task.isWaydroidHostWindow();
         task.setWaydroidHostWindow(routeToHostWindow);
 
-        // A default-display launch from another Android task owns the normal fullscreen route.
         // Do not touch non-default displays: Avium/MiFreeform owns their windowing policy.
-        if (wasHostWindow && !routeToHostWindow && !sameTaskNavigation
-                && task.getDisplayId() == DEFAULT_DISPLAY && task.inFreeformWindowingMode()) {
-            task.setWindowingMode(WINDOWING_MODE_FULLSCREEN);
+        if (!defaultDisplay) {
+            return;
+        }
+
+        if (routeToHostWindow) {
+            if (!task.inFreeformWindowingMode()) {
+                task.setWindowingMode(WINDOWING_MODE_FREEFORM);
+            }
+            return;
+        }
+
+        // A default-display launch from Android (no trusted host cookie) owns the normal
+        // fullscreen route, even while host-routed desktop tasks are active on the same
+        // display. Move the task out of the Waydroid desk root so AviumUI's default
+        // full-screen experience coexists with Linux host windows.
+        if (sameTaskNavigation && !wasHostWindow) {
+            return;
+        }
+        final TaskDisplayArea taskDisplayArea = task.getDisplayArea();
+        if (taskDisplayArea == null) {
+            return;
+        }
+        final Task rootTask = task.getRootTask();
+        final boolean enteringWaydroidFreeform =
+                task.inFreeformWindowingMode()
+                || (rootTask != null && rootTask.inFreeformWindowingMode());
+        if (!enteringWaydroidFreeform) {
+            // Normal Android fullscreen / multi-window launches are untouched.
+            return;
+        }
+        if (rootTask != null && rootTask != task) {
+            // Leave the Waydroid desk root; a non-host launch owns the
+            // fullscreen route on the default display.
+            task.reparent(taskDisplayArea, true /* onTop */);
         }
+        task.setWindowingMode(WINDOWING_MODE_FULLSCREEN);
     }
 
     private boolean hasTrustedWaydroidHostWindowCookie() {
