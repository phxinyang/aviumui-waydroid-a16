+        assertFalse(mRootWindowContainer.topRunningActivity().getTask()
+                .isWaydroidHostWindow());
+        assertEquals(WINDOWING_MODE_FULLSCREEN,
+                mRootWindowContainer.topRunningActivity().getTask().getWindowingMode());
+    }
+
     @Test
     public void testRemoteAnimation_appliesToExistingTask() {
         final ActivityStarter starter = prepareStarter(0, false);
