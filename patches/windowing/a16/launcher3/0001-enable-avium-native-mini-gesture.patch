From 3eff9d317b0b4b91e4e62a5df06dead65a6283ff Mon Sep 17 00:00:00 2001
From: Avium A16 Reproducer <avium-a16-reproducer@example.invalid>
Date: Thu, 13 Aug 2026 08:48:31 +0000
Subject: [PATCH] launcher3: restore official PopUp 101 mini gesture

The AviumUI swipe-up-and-hold gesture is dead code on tablets: persist.avium.launchergesture
defaults off and CUSTOM_GESTURE_TRIGGER_THRESHOLD 3.5f is above mCurrentShift (clamped to
mDragLengthFactor, ~1.3-1.7). Lower the threshold to 1.1f so the gesture is reachable past
overview, and keep the official avium-16.2 landing: startActivityFromRecents with
launchWindowingMode=101 (pinned popup). That is the same-task PopUp chrome with the system
white edge bar on 102, not the MiFreeform overlay card.

Also null-check baseIntent.getComponent() so the launcher skip does not NPE.

Change-Id: I7a2c0e1b4f8d6a9c3e5b0d2a8f1c4e7b9a0d3f56
---
 quickstep/src/com/android/quickstep/AbsSwipeUpHandler.java | 6 ++++--
 1 file changed, 4 insertions(+), 2 deletions(-)

diff --git a/quickstep/src/com/android/quickstep/AbsSwipeUpHandler.java b/quickstep/src/com/android/quickstep/AbsSwipeUpHandler.java
index 23c5ee877b..f087f5c09c 100644
--- a/quickstep/src/com/android/quickstep/AbsSwipeUpHandler.java
+++ b/quickstep/src/com/android/quickstep/AbsSwipeUpHandler.java
@@ -241,7 +241,7 @@ public abstract class AbsSwipeUpHandler<
     // The previous task view type before the user quick switches between tasks
     private TaskViewType mPreviousTaskViewType;
     //Ext add
-    private static final float CUSTOM_GESTURE_TRIGGER_THRESHOLD = 3.5f;
+    private static final float CUSTOM_GESTURE_TRIGGER_THRESHOLD = 1.1f;
     private static final String ACTION_PIN_LAST_APP = "org.avium.PINNED_LAST_APP";
     private boolean mAviumGestureHintShown = false;
     private Toast mAviumGestureToast = null;
@@ -3285,7 +3285,9 @@ public abstract class AbsSwipeUpHandler<
         final int taskId = currentTask.id;
 
         final String launcherPackageName = mContext.getPackageName();
-        if (currentTask.baseIntent != null && launcherPackageName.equals(currentTask.baseIntent.getComponent().getPackageName())) {
+        if (currentTask.baseIntent != null
+                && currentTask.baseIntent.getComponent() != null
+                && launcherPackageName.equals(currentTask.baseIntent.getComponent().getPackageName())) {
             return;
         }
 
-- 
