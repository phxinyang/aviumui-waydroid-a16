+void window::apply_task_window_state(const task_window_state_update &update) {
+    requested_task_window_state = update.state;
+    requested_task_window_generation = update.generation;
+    if (update.source == waydroid_task_window_state_source::Host)
+        host_task_window_state_request_pending = false;
+    switch (update.state) {
+        case waydroid_task_window_state::Normal:
+            set_maximize(false);
+            task_window_state_ack_pending = xdg_toplevel != nullptr;
+            break;
+        case waydroid_task_window_state::Maximized:
+            set_maximize(true);
+            task_window_state_ack_pending = xdg_toplevel != nullptr;
+            break;
+        case waydroid_task_window_state::Minimized:
+            minimize();
+            observed_task_window_state = waydroid_task_window_state::Minimized;
+            task_window_state_ack_pending = false;
+            break;
+        case waydroid_task_window_state::FullUi:
+            if (taskID == "0")
+                set_maximize(true);
+            task_window_state_ack_pending = false;
+            break;
+    }
+    ALOGI("task %s applies window state=%u source=%u generation=%" PRIu64,
+            taskID.c_str(), static_cast<uint32_t>(update.state),
+            static_cast<uint32_t>(update.source), update.generation);
+}
+
+bool window::observe_task_window_state(waydroid_task_window_state state,
+        bool activated) {
+    if (task_window_state_ack_pending && state == requested_task_window_state) {
+        observed_task_window_state = state;
+        task_window_state_ack_pending = false;
+        ALOGI("task %s acks window state=%u generation=%" PRIu64,
+                taskID.c_str(), static_cast<uint32_t>(state),
+                requested_task_window_generation);
+        return false;
+    }
+    if (state == observed_task_window_state)
+        return false;
+    // xdg-shell has no minimized state.  Some compositors send an
+    // unactivated normal configure while honoring set_minimized(); only an
+    // activated configure is evidence that the host restored the window.
+    if (observed_task_window_state == waydroid_task_window_state::Minimized
+            && state == waydroid_task_window_state::Normal && !activated) {
+        return false;
+    }
+    observed_task_window_state = state;
+    task_window_state_ack_pending = false;
+    host_task_window_state_request_pending = true;
+    return true;
 }

