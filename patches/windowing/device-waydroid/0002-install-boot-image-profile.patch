From cbc6bf442154f0e6781b83df1bbbed1327d217fb Mon Sep 17 00:00:00 2001
From: Avium A16 Reproducer <avium-a16-reproducer@example.invalid>
Date: Tue, 11 Aug 2026 11:17:31 +0000
Subject: [PATCH] device/waydroid: install boot image profile into system/etc

---
 device.mk                |   4 ++++
 prebuilt/boot-image.prof | Bin 0 -> 19287 bytes
 2 files changed, 4 insertions(+)
 create mode 100644 prebuilt/boot-image.prof

diff --git a/device.mk b/device.mk
index a1e5db8..33126e0 100644
--- a/device.mk
+++ b/device.mk
@@ -363,3 +363,7 @@ PRODUCT_DEXPREOPT_SPEED_APPS += \
 # Fingerprint spoof for GApps
 BUILD_FINGERPRINT := google/tangorpro/tangorpro:16/BP4A.260205.001/14624666:user/release-keys
 endif
+
+# Waydroid userdebug: keep the boot image profile on /system so zygote can
+# compile a matching boot image on first boot when dexpreopt is disabled.
+PRODUCT_COPY_FILES += device/waydroid/waydroid/prebuilt/boot-image.prof:system/etc/boot-image.prof
diff --git a/prebuilt/boot-image.prof b/prebuilt/boot-image.prof
new file mode 100644
index 0000000000000000000000000000000000000000..db88b45a6b3299ace6c352950207d10140305417
GIT binary patch
