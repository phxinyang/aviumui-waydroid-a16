---
 configs/media_codecs.xml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/configs/media_codecs.xml b/configs/media_codecs.xml
index f05f9a5..bae2206 100644
--- a/configs/media_codecs.xml
+++ b/configs/media_codecs.xml
@@ -84,6 +84,6 @@ Only the three quirks included above are recognized at this point:
     <Settings>
         <Setting name="max-video-encoder-input-buffers" value="12" />
     </Settings>
-    <Include href="media_codecs_ffmpeg_c2.xml" />
     <Include href="media_codecs_c2.xml" />
+    <Include href="media_codecs_ffmpeg_c2.xml" />
 </MediaCodecs>
